# AgriPrice-AI Environment Variables Template
PROJECT_NAME="AgriPrice-AI"
VERSION="1.0.0"
LOG_LEVEL="INFO"

# Database Configuration (Defaults to SQLite; switch to Postgres/TimescaleDB in production)
DATABASE_URL="sqlite:///agriprice.db"
POSTGRES_TIMESCALE_URL="postgresql://postgres:postgres@localhost:5432/agriprice"

# Official Data Ingestion Keys
# Register on https://data.gov.in to obtain an API key for live Agmarknet mandi arrivals
DATA_GOV_API_KEY="DEMO_KEY"
DATA_GOV_IN_API_KEY="DEMO_KEY"

# Telegram Bot (Optional, for Phase 5 bot alerts)
TELEGRAM_BOT_TOKEN=""
